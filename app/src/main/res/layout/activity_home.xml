<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Logo / Title Area -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="48dp">

            <!-- Dice icon cluster -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="24dp">

                <View
                    android:id="@+id/logo_glow"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:background="@drawable/logo_glow_bg" />

                <ImageView
                    android:id="@+id/logo_dice"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:contentDescription="Ludo Logo" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUDO"
                android:textColor="@color/accent_gold"
                android:textSize="48sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BOARD PLAY"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.4" />
        </LinearLayout>

        <!-- Player Count Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Players"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <!-- 2 Players -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_2_players"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/dark_surface"
                app:strokeColor="@color/board_grid"
                app:strokeWidth="1.5dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="@color/ludo_red"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Players"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/circle_indicator" android:backgroundTint="@color/ludo_red" android:layout_marginEnd="4dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/circle_indicator" android:backgroundTint="@color/ludo_yellow"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3 Players -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_3_players"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/dark_surface"
                app:strokeColor="@color/board_grid"
                app:strokeWidth="1.5dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="@color/ludo_green"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Players"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/circle_indicator" android:backgroundTint="@color/ludo_red" android:layout_marginEnd="4dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/circle_indicator" android:backgroundTint="@color/ludo_green" android:layout_marginEnd="4dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/circle_indicator" android:backgroundTint="@color/ludo_yellow"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4 Players -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_4_players"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/dark_surface"
                app:strokeColor="@color/accent_gold"
                app:strokeWidth="2dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textColor="@color/accent_gold"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Players"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/circle_indicator" android:backgroundTint="@color/ludo_red" android:layout_marginEnd="4dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/circle_indicator" android:backgroundTint="@color/ludo_green" android:layout_marginEnd="4dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/circle_indicator" android:backgroundTint="@color/ludo_yellow" android:layout_marginEnd="4dp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/circle_indicator" android:backgroundTint="@color/ludo_blue"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Game Mode Toggle -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/dark_surface_variant"
            app:strokeColor="@color/board_grid"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Play with Lori"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_ai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/accent_gold"
                    app:trackTint="@color/board_grid" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Start Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="START GAME"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:cornerRadius="20dp"
            app:backgroundTint="@color/accent_gold"
            android:textColor="@color/black"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconTint="@color/black" />

        <!-- Old buttons removed, moved to popup menu -->

        <!-- Version tag -->
        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="v3.3.1 • Made with ♥"
            android:textColor="@color/board_grid"
            android:textSize="12sp" />

    </LinearLayout>
    </ScrollView>

    <!-- Top-Left Overflow Menu -->
    <ImageButton
        android:id="@+id/btn_menu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_vert"
        android:contentDescription="Menu"
        android:layout_gravity="top|start" />

</FrameLayout>
