<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="8dp"
    android:clipChildren="false"
    tools:context=".MainActivity">

    <!-- Player 0 (Red) Indicator -->
    <LinearLayout
        android:id="@+id/indicator_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/indicator_bg"
        android:padding="4dp"
        android:clipChildren="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/board_card"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="8dp">
        
        <ImageView android:id="@+id/icon_0" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/circle_indicator" app:tint="@color/ludo_red" android:layout_margin="4dp"/>
        <FrameLayout android:id="@+id/placeholder_0" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/placeholder_bg" android:clipChildren="false" />
    </LinearLayout>

    <!-- Floating Header Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/dark_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageButton
                android:id="@+id/btn_home"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_home"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUDO"
                android:textColor="@color/accent_gold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_centerInParent="true" />

            <ImageButton
                android:id="@+id/btn_reset"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_refresh"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Reset" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Player 1 (Green) Indicator -->
    <LinearLayout
        android:id="@+id/indicator_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/indicator_bg"
        android:padding="4dp"
        android:clipChildren="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_controls"
        android:layout_marginTop="8dp">
        
        <FrameLayout android:id="@+id/placeholder_1" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/placeholder_bg" android:clipChildren="false" />
        <ImageView android:id="@+id/lori_dp_1" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/lori_avatar" android:visibility="gone" android:layout_margin="4dp" />
        <ImageView android:id="@+id/icon_1" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/circle_indicator" app:tint="@color/ludo_green" android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- Ludo Board Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/board_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="@color/board_bg"
        app:strokeColor="@color/board_grid"
        app:strokeWidth="1.5dp"
        app:layout_constraintBottom_toTopOf="@id/indicator_0"
        app:layout_constraintTop_toBottomOf="@id/indicator_1">

        <!-- Custom Board View -->
        <in.bikdocs.ludo.LudoBoardView
            android:id="@+id/ludo_board_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Player 3 (Blue) Indicator -->
    <LinearLayout
        android:id="@+id/indicator_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/indicator_bg"
        android:padding="4dp"
        android:clipChildren="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/board_card"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="8dp">
        
        <ImageView android:id="@+id/icon_3" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/circle_indicator" app:tint="@color/ludo_blue" android:layout_margin="4dp"/>
        <ImageView android:id="@+id/lori_dp_3" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/lori_avatar" android:visibility="gone" android:layout_margin="4dp" />
        <FrameLayout android:id="@+id/placeholder_3" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/placeholder_bg" android:clipChildren="false" />
    </LinearLayout>

    <!-- Player 2 (Yellow) Indicator -->
    <LinearLayout
        android:id="@+id/indicator_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/indicator_bg"
        android:padding="4dp"
        android:clipChildren="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_controls"
        android:layout_marginTop="8dp">
        
        <FrameLayout android:id="@+id/placeholder_2" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/placeholder_bg" android:clipChildren="false" />
        <ImageView android:id="@+id/lori_dp_2" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/lori_avatar" android:visibility="gone" android:layout_margin="4dp" />
        <ImageView android:id="@+id/icon_2" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/circle_indicator" app:tint="@color/ludo_yellow" android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- Floating Dice Button -->
    <FrameLayout
        android:id="@+id/dice_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/dice_button_bg"
        android:elevation="8dp"
        android:clipChildren="false"
        app:layout_constraintStart_toStartOf="@id/placeholder_0"
        app:layout_constraintEnd_toEndOf="@id/placeholder_0"
        app:layout_constraintTop_toTopOf="@id/placeholder_0"
        app:layout_constraintBottom_toBottomOf="@id/placeholder_0">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_dice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:scaleX="1.8"
            android:scaleY="1.8"
            app:lottie_rawRes="@raw/dice_roll"
            app:lottie_loop="true"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/dice_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="visible" />
    </FrameLayout>

    <!-- Celebration Overlay -->
    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
